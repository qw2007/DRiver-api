# 本机覆盖项：`docker compose up -d` 会自动读取同目录的 .env。
# 复制成 .env 再按需修改；.env 已进 .gitignore，别把它提交上去。
#
# 生产至少要改这两个：默认值是为了「clone 下来就能跑」而存在，任何人都知道它们。

# 格式：secret:scope1|scope2 或 secret:*（全权），多把钥匙用逗号分隔
#   admin-key   —— 管理远程插件（plugin_admin），调不了普通工具
#   read-key    —— 只能调 search_database 与 echo
#   pho-agent   —— PhoNote 的 Agent 窄钥匙（只能读）
DRIVER_API_KEYS=admin-key:plugin_admin,read-key:search_database|echo,pho-agent:note_tree|note_get|note_list_captures|note_export

# 端口（宿主冲突时改这里）
DRIVER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana 管理员密码
GRAFANA_PASSWORD=admin

# —— 可选：把笔记插件也挂上（PhoNote）——
# DRIVER_PLUGINS=sqlite,pho_note
# DRIVER_NOTES_DIR=/notes
# DRIVER_NOTES_UI=1
# DRIVER_NOTES_LLM=manual
