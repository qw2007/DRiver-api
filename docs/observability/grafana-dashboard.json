{
  "uid": "driver-platform-overview",
  "title": "驱动平台 · 阶段 5 概览",
  "description": "阶段 5 验收的三条线：QPS / P95 延迟 / 错误率，外加工具调用分布。数据源 uid 固定为 prom-main：compose 起全平台时由 Grafana provisioning 自动装配，手工导入时请先建一个 uid=prom-main 的 Prometheus 数据源（或导入后在面板里改数据源）。",
  "tags": ["driver-platform", "stage-5", "stage-7"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS",
      "description": "sum(rate(driver_http_requests_total[1m]))",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom-main" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(driver_http_requests_total[1m]))",
          "legendFormat": "全部请求"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 延迟（按路由）",
      "description": "histogram_quantile(0.95, sum by (le, route) (rate(driver_http_request_duration_seconds_bucket[5m])))",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom-main" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(driver_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "错误率（5xx 占比）",
      "description": "sum(rate(driver_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(driver_http_requests_total[5m])) or vector(0)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom-main" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(driver_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(driver_http_requests_total[5m])) or vector(0)",
          "legendFormat": "5xx 占比"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "工具调用（按工具与结果）",
      "description": "sum by (tool, outcome) (rate(driver_tool_calls_total[5m]))",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom-main" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(driver_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} / {{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {}
    }
  ]
}
